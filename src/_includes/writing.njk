<div class="writing-list">
{% for post in writing %}
  <a class="writing-item" href="{{ post.url }}">
    <time datetime="{{ post.date | dateISO }}">{{ post.date | dateLabel }}</time>
    <div><h3>{{ post.data.title }}</h3><p>{{ post.data.description }}</p></div>
    <span class="arrow" aria-hidden="true">↗</span>
  </a>
{% endfor %}
</div>

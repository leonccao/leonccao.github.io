---
layout: base.njk
---
<section class="hero" aria-labelledby="intro-title">
  <div class="hero-title"><p class="eyebrow">A personal lab</p>
  <h1 id="intro-title">Understanding things by building them.</h1></div>
  <div class="hero-body">
  <p class="intro">{{ site.intro }}</p>
  <div class="hero-links"><a class="text-link" href="#projects">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href="/archives/">Read my notes <span aria-hidden="true">→</span></a></div>
  </div>
  <div class="interests"><span>Currently exploring</span> Language models <span aria-hidden="true">/</span> Learning from first principles</div>
</section>
<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="section-heading"><div><p class="eyebrow">The workbench</p><h2 id="projects-title">Selected work</h2></div><span class="section-note">Experiments & learning projects</span></div>
  <p class="section-intro">Two learning tracks in <a href="https://github.com/leonccao/language-modeling-from-scratch">language-modeling-from-scratch</a>. Small pieces, built to understand the bigger picture.</p>
  <div class="project-list">{% for project in projects %}
    <article class="project">
      <div class="project-content"><p class="eyebrow">{{ project.label }}</p><h3>{{ project.title }}</h3><p>{{ project.description }}</p><p class="topics">{{ project.topics }}</p><a class="text-link" href="{{ project.url }}">Explore the learning track <span aria-hidden="true">↗</span></a></div>
      <figure><img src="{{ project.image }}" alt="{{ project.alt }}" width="480" height="240"><figcaption>Conceptual illustration</figcaption></figure>
    </article>
  {% endfor %}</div>
</section>
<section class="section" aria-labelledby="writing-title">
  <div class="section-heading"><div><p class="eyebrow">The notebook</p><h2 id="writing-title">Notes along the way</h2></div><a class="text-link" href="/archives/">All writing <span aria-hidden="true">→</span></a></div>
  {% set writing = collections.writing %}{% include "writing.njk" %}
</section>
